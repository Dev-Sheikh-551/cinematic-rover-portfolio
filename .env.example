# ── Core ─────────────────────────────────────────────────────────────────────
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (injected by Cloud Run at runtime).
APP_URL="MY_APP_URL"

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example: postgresql://postgres:postgres@localhost:5432/portfolio
# Production: Use Supabase / Railway / Neon / PlanetScale connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio"

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — must be at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-strong-random-secret-min-32-chars"

# ── Email (Phase 4.3) ─────────────────────────────────────────────────────────
# Resend API key for transactional email sending.
# Obtain from: https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
